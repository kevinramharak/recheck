{
  "name": "recheck",
  "version": "0.0.0",
  "description": "The trustworthy ReDoS checker",
  "license": "MIT",
  "author": {
    "name": "TSUYUSATO Kitsune",
    "email": "make.just.on@gmail.com"
  },
  "homepage": "https://makenowjust-labs.github.io/recheck/",
  "repository": {
    "type": "git",
    "url": "https://github.com/makenowjust-labs/recheck.git"
  },
  "type": "module",
  "sideEffects": false,
  "types": "types.d.ts",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "browser": "lib/browser.cjs",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "browser": "./lib/browser.js",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.cjs"
    },
    "./core": {
      "types": "./core.d.ts",
      "browser": "./lib/core/index.js",
      "require": "./lib/core/index.cjs",
      "import": "./lib/core/index.js",
      "default": "./lib/core/index.cjs"
    },
    "./core/*": {
      "browser": "./lib/core/*.js",
      "require": "./lib/core/*.cjs",
      "import": "./lib/core/*.js",
      "default": "./lib/core/*.cjs"
    },
    "./core/backend/*": {
      "browser": "./lib/core/backend/*.js",
      "require": "./lib/core/backend/*.cjs",
      "import": "./lib/core/backend/*.js",
      "default": "./lib/core/backend/*.cjs"
    },
    "./core/backend/web-worker": {
      "browser": "./lib/core/backend/web-worker/index.js",
      "require": "./lib/core/backend/web-worker/index.cjs",
      "import": "./lib/core/backend/web-worker/index.js",
      "default": "./lib/core/backend/web-worker/index.cjs"
    },
    "./core/backend/thread-worker": {
      "browser": "./lib/core/backend/thread-worker/index.js",
      "require": "./lib/core/backend/thread-worker/index.cjs",
      "import": "./lib/core/backend/thread-worker/index.js",
      "default": "./lib/core/backend/thread-worker/index.cjs"
    },
    "./*.worker": {
      "import": "./lib/*.worker.js",
      "browser": "./lib/*.worker.js",
      "require": "./lib/*.worker.cjs",
      "default": "./lib/*.worker.cjs"
    },
    "./*.worker.js": {
      "import": "./lib/*.worker.js",
      "browser": "./lib/*.worker.js",
      "require": "./lib/*.worker.cjs",
      "default": "./lib/*.worker.cjs"
    },
    "./*.worker.cjs": {
      "require": "./lib/*.worker.cjs",
      "default": "./lib/*.worker.cjs"
    }
  },
  "files": [
    "core.d.ts",
    "types.d.ts",
    "lib"
  ],
  "scripts": {
    "build": "node -r esbuild-register ./scripts/build.ts",
    "clean": "rimraf lib",
    "format": "prettier -w '*.{js,json,md}' '{scripts,src}/**/*.{js,{ts,.d.ts}}' types.d.ts",
    "lint": "prettier --check '*.{js,json,md}' '{scripts,src}/**/*.{js,{ts,.d.ts}}' types.d.ts",
    "test": "SYNCKIT_TS_RUNNER=esbuild-register jest",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "synckit": "0.11.13"
  },
  "optionalDependencies": {
    "recheck-jar": "0.0.0",
    "recheck-linux-arm64": "0.0.0",
    "recheck-linux-x64": "0.0.0",
    "recheck-macos-x64": "0.0.0",
    "recheck-macos-arm64": "0.0.0",
    "recheck-windows-x64": "0.0.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "esbuild-jest": "0.5.0",
    "esbuild-register": "3.6.0",
    "jest": "30.4.2",
    "prettier": "3.8.5",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "redos",
    "regexp",
    "security",
    "vulnerability"
  ]
}
